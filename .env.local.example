# ──────────────────────────────────────────────────────────
# VEEW Connect — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub
# ──────────────────────────────────────────────────────────

# Supabase — lấy từ: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — lấy từ: resend.com → API Keys
RESEND_API_KEY=re_your-api-key-here

# Email gửi đi (phải verify domain trong Resend)
RESEND_FROM_EMAIL=noreply@veew.vn
RESEND_FROM_NAME=VEEW Connect 2026

# App URL (dùng cho email links)
NEXT_PUBLIC_APP_URL=https://connect.veew.vn
